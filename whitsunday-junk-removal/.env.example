# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Your live address, no trailing slash (e.g. https://www.yourdomain.com.au)
NEXT_PUBLIC_SITE_URL=

# Resend (https://resend.com) — for emailing invoices and quote alerts
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. Whitsunday Junk Removal <accounts@yourdomain.com.au>
EMAIL_FROM=
